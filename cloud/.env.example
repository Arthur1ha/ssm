# ── 共享模型服务（按所用服务填写地址、密钥和模型 ID）──
OPENAI_API_KEY="your-api-key-here"
OPENAI_BASE_URL="https://tokenhub.tencentmaas.com/v1"
# 文字推理：管家、灯、机器狗及其他文字决策共用
TEXT_MODEL=deepseek-v4.1-flash

# 视觉识别：全系统共用，模型 ID 需由上面的服务提供
VISION_MODEL=glm-5.3-flashx

# Go2 人脸身份（腾讯云 IAI 3.0；密钥只填写在部署机 cloud/.env）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-shanghai
TENCENT_FACE_GROUP_ID=123456
GO2_FACE_RECOGNITION_ENABLED=true
SPACE_FACE_ENROLLMENT_ENABLED=true
GO2_FACE_TIMEOUT_S=5
# 身份匹配阈值固定为 80 分，不使用分数配置或候选确认阶段
# 身份结果最多保留 5 秒；复查间隔取 1~5 秒，旧的更大配置按 5 秒处理
GO2_FACE_RECHECK_S=5

# 视觉教导观察：全局节流，不需要逐条规则配置。
# 本地画面检查沿用 1 秒采样；有变化时两次模型请求发起至少间隔 3 秒。
GO2_TRAINING_VISION_MIN_INTERVAL_S=3
# 距离上一次成功分析完成的静态兜底间隔；变化成功分析会重新计时。
GO2_TRAINING_VISION_FALLBACK_S=30
# 模型请求失败或超时后，从失败完成时计时，期间不重复请求。
GO2_TRAINING_VISION_RETRY_S=10


# MQTT broker（与 ESP32 config.py 中的 MQTT_BROKER_IP 保持一致）
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# ACL 部署推荐为 API / 编排器分别创建账号；未填时兼容回退到上面账号。
MQTT_API_USER=ssm_api
MQTT_API_PASSWORD=
MQTT_ORCHESTRATOR_USER=ssm_orchestrator
MQTT_ORCHESTRATOR_PASSWORD=

# 编排器 MQTT 身份
ORCHESTRATOR_ID=cloud_orchestrator

# 单一空间会话（真实值只写入 cloud/.env）
SSM_SESSION_SECRET=
# API 与编排器共用的内部服务配置；填写一次即可，也用于派生 MQTT 控制消息签名。
SSM_INTERNAL_SERVICE_TOKEN=

# Independent state-machine training configuration (never imports old teachings).
# API is the only configuration writer; executors acknowledge exact versions.
SSM_TRAINING_DIR=cloud/agents/data/training
# 无需单独设置；默认从上面的内部服务配置派生。
SSM_MQTT_SIGNING_SECRET=
ADMIN_SESSION_TTL_S=28800
VISITOR_SESSION_TTL_S=7200
# 断线后的普通控制权回收兜底；新目标正常交接不等待此时长。
# 停止未确认的交接占用不能靠超时解除。
GO2_VISITOR_LEASE_TTL_S=30
# 目标代次默认保存在 cloud/space/data/user_goals/；仅需改存储位置时设置绝对路径。
# SSM_USER_GOALS_DIR=/absolute/path/to/user_goals
# HTTPS 部署保持 true；仅本机 HTTP 调试可设 false
SSM_COOKIE_SECURE=true
# 跨域 PWA 时填精确 origin，多个用逗号分隔；同源部署留空
SSM_ALLOWED_ORIGINS=
# API 进程内部回调 Go2 路由
SSM_INTERNAL_API_BASE_URL=http://127.0.0.1:8082
