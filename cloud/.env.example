# ── SJTU DeepSeek API（编排器、ESP32 智能体、Go2 智能体统一使用）──
OPENAI_API_KEY="your-sjtu-api-key-here"
OPENAI_BASE_URL="https://models.sjtu.edu.cn/api/v1"
# 按顺序尝试，前一个 429/限额时自动切下一个
MODEL_LIST=deepseek-chat

# Go2 智能体模型（文本/视觉分开，视觉必须用 qwen 别名，全名调用报错）
GO2_TEXT_MODEL=deepseek-chat
GO2_VISION_MODEL=qwen

# Go2 人脸身份（腾讯云 IAI 3.0；密钥只填写在部署机 cloud/.env）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-shanghai
TENCENT_FACE_GROUP_ID=123456
GO2_FACE_RECOGNITION_ENABLED=true
GO2_FACE_ENROLLMENT_ENABLED=false
GO2_FACE_TIMEOUT_S=5
GO2_FACE_ACCEPT_SCORE=90
GO2_FACE_CANDIDATE_SCORE=80
GO2_FACE_RECHECK_S=30


# MQTT broker（与 ESP32 config.py 中的 MQTT_BROKER_IP 保持一致）
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# ACL 部署推荐为 API / 编排器分别创建账号；未填时兼容回退到上面账号。
MQTT_API_USER=ssm_api
MQTT_API_PASSWORD=
MQTT_ORCHESTRATOR_USER=ssm_orchestrator
MQTT_ORCHESTRATOR_PASSWORD=

# 编排器 MQTT 身份
ORCHESTRATOR_ID=cloud_orchestrator

# 单一空间会话（真实值只写入 cloud/.env）
SSM_SESSION_SECRET=
# API 与编排器共用的内部服务配置；填写一次即可，也用于派生 MQTT 控制消息签名。
SSM_INTERNAL_SERVICE_TOKEN=
# 无需单独设置；默认从上面的内部服务配置派生。
SSM_MQTT_SIGNING_SECRET=
ADMIN_SESSION_TTL_S=28800
VISITOR_SESSION_TTL_S=7200
GO2_VISITOR_LEASE_TTL_S=30
# HTTPS 部署保持 true；仅本机 HTTP 调试可设 false
SSM_COOKIE_SECURE=true
# 跨域 PWA 时填精确 origin，多个用逗号分隔；同源部署留空
SSM_ALLOWED_ORIGINS=
# API 进程内部回调 Go2 路由
SSM_INTERNAL_API_BASE_URL=http://127.0.0.1:8082
