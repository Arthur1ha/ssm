${SSM_DIR}/logs/api.log ${SSM_DIR}/logs/esp32.log ${SSM_DIR}/logs/go2.log ${SSM_DIR}/logs/orchestrator.log ${SSM_DIR}/logs/pwa.log ${SSM_DIR}/logs/tunnel.log ${SSM_DIR}/logs/mosquitto.log {
    su ${SSM_LOG_USER} ${SSM_LOG_GROUP}
    daily
    maxsize 20M
    rotate 5
    maxage 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
